-- Freak colours package

pilot mut foregroundColor: word = "\x1b[39m"
pilot mut backgroundColor: word = "\x1b[49m"


task sayC(text: word) -> void {

say foregroundColor + backgroundColor + text + "\x1b[0m"

}



task resetColors() -> void {

	foregroundColor = "\x1b[39m"
	backgroundColor = "\x1b[49m"

}

task setFG_red() -> void {

	foregroundColor = "\x1b[1;31m"

}
task setFG_black() -> void {

	foregroundColor = "\x1b[1;30m"

}
